<mujoco model="h1 scene with depth camera">
  <include file="h1_camera.xml"/>

  <statistic center="1.0 0.7 1.0" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
    <!-- offscreen buffer: large enough for depth_cam (64x64) and any extra cameras -->
    <quality offsamples="0"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>

    <!--
      Terrain geoms are placed in group=2 so the depth renderer can keep them
      visible while hiding the robot's own body geoms (which are in groups 0/1).
      This mirrors the training depth distribution: the warp renderer used during
      training only includes static terrain meshes and excludes the robot mesh
      (see body_mask_data/README.md and `cfg.depth.add_body_mask`).
    -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" group="2"/>
    <geom name="step1" type="box" size="0.2 0.6 0.05"  pos="1.5 0 0.05"  rgba="0.6 0.5 0.4 1" group="2"/>
    <geom name="step2" type="box" size="0.2 0.6 0.10"  pos="1.9 0 0.10"  rgba="0.6 0.5 0.4 1" group="2"/>
    <geom name="step3" type="box" size="0.2 0.6 0.15"  pos="2.3 0 0.15"  rgba="0.6 0.5 0.4 1" group="2"/>
    <geom name="step4" type="box" size="0.2 0.6 0.20"  pos="2.7 0 0.20"  rgba="0.6 0.5 0.4 1" group="2"/>
  </worldbody>
</mujoco>
