      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="pelvis"/>
      <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="pelvis"/>
