
from legged_gym.envs.base.legged_robot import LeggedRobot

from isaacgym.torch_utils import *
from isaacgym import gymtorch, gymapi, gymutil
from legged_gym.utils.isaacgym_utils import get_euler_xyz as get_euler_xyz_in_tensor
from legged_gym.utils.math import wrap_to_pi
from legged_gym.datasets.motion_loader_g1 import G1_AMPLoader
import os
import numpy as np
import torch
import cv2
import torch.nn.functional as F

class G1_16Dof_Loco_Robot(LeggedRobot):
    def __init__(self, cfg, sim_params, physics_engine, sim_device, headless):
        super().__init__(cfg, sim_params, physics_engine, sim_device, headless)
        self.amp_motion_files = self.cfg.env.amp_motion_files
        self.num_amp_obs = self.cfg.env.num_amp_obs
        if self.cfg.env.reference_state_initialization: # NOTE only for visualize reference motion
            self.amp_loader = G1_AMPLoader(motion_dir=self.amp_motion_files, device=self.device, time_between_frames=self.dt)
            self.motion_reference = self.amp_loader.get_joint_pose_batch_16dof(torch.cat(self.amp_loader.trajectories_full, dim=0))
        
    def get_amp_observations(self):
        return self.dof_pos

    def _get_noise_scale_vec(self, cfg):
        """ Sets a vector used to scale the noise added to the observations.
            [NOTE]: Must be adapted when changing the observations structure

        Args:
            cfg (Dict): Environment config file

        Returns:
            [torch.Tensor]: Vector of scales used to multiply a uniform distribution in [-1, 1]
        """
        noise_vec = torch.zeros_like(self.obs_buf[0])
        self.add_noise = self.cfg.noise.add_noise
        noise_scales = self.cfg.noise.noise_scales
        noise_level = self.cfg.noise.noise_level
        noise_vec[:3] = 0. # commands
        noise_vec[3:6] = noise_scales.ang_vel * noise_level * self.obs_scales.ang_vel
        noise_vec[6:9] = noise_scales.gravity * noise_level
        noise_vec[9:9+self.num_actions] = noise_scales.dof_pos * noise_level * self.obs_scales.dof_pos
        noise_vec[9+self.num_actions:9+2*self.num_actions] = noise_scales.dof_vel * noise_level * self.obs_scales.dof_vel
        noise_vec[9+2*self.num_actions:9+3*self.num_actions] = 0. # previous actions
        
        return noise_vec

    def _init_buffers(self):
        super()._init_buffers()
        self.was_contact = torch.zeros(self.num_envs, 2, dtype=torch.bool, device=self.device)
        self.last_last_actions = torch.zeros(self.num_envs, self.num_actions, dtype=torch.float, device=self.device, requires_grad=False)
        self.last_feet_contact_force = torch.zeros(self.num_envs, 2, 3, dtype=torch.float, device=self.device, requires_grad=False)
        self.last_last_feet_contact_force = torch.zeros(self.num_envs, 2, 3, dtype=torch.float, device=self.device, requires_grad=False)
        self.feet_indicator_offset = torch.tensor(self.cfg.asset.feet_indicator_offset, dtype=torch.float, device=self.device, requires_grad=False)
        self.feet_indicator_pos = torch.zeros(self.num_envs, len(self.feet_indices), *self.feet_indicator_offset.shape,dtype=torch.float, device=self.device, requires_grad=False)
        self._init_footstep_guidance_buffers()

    def render(self, sync_frame_time=True):
        if self.viewer and getattr(self.cfg.terrain, "visualize_safety_map", False):
            self._draw_terrain_safety_overlay()
        if (self.viewer and self.enable_viewer_sync and self.debug_viz and
                self._fg_enabled() and getattr(self._fg_cfg(), "visualize_footstep_targets", False)):
            self._draw_footstep_targets()
        if (self.viewer and self.enable_viewer_sync and self.debug_viz and
                self._fg_enabled() and getattr(self._fg_cfg(), "visualize_affordance_candidates", False)):
            self._draw_affordance_candidates()
        return super(LeggedRobot, self).render(sync_frame_time=sync_frame_time)

    def _fg_cfg(self):
        return getattr(self.cfg, "footstep_guidance", None)

    def _fg_enabled(self):
        cfg = self._fg_cfg()
        return cfg is not None and getattr(cfg, "enable_footstep_guidance", False)

    def _init_footstep_guidance_buffers(self):
        cfg = self._fg_cfg()
        max_targets = int(getattr(cfg, "max_targets", 64)) if cfg is not None else 64
        self.footstep_max_targets = max_targets
        self.footstep_path_active = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
        self.footstep_path_start_xy = torch.zeros(self.num_envs, 2, dtype=torch.float, device=self.device)
        self.footstep_path_end_xy = torch.zeros(self.num_envs, 2, dtype=torch.float, device=self.device)
        self.footstep_path_dir_xy = torch.zeros(self.num_envs, 2, dtype=torch.float, device=self.device)
        self.footstep_path_dir_xy[:, 0] = 1.0
        self.footstep_path_normal_xy = torch.zeros(self.num_envs, 2, dtype=torch.float, device=self.device)
        self.footstep_path_normal_xy[:, 1] = 1.0
        self.footstep_path_len = torch.zeros(self.num_envs, dtype=torch.float, device=self.device)
        self.footstep_path_heading = torch.zeros(self.num_envs, dtype=torch.float, device=self.device)
        self.footstep_targets_xy = torch.zeros(self.num_envs, max_targets, 2, 2, dtype=torch.float, device=self.device)
        self.footstep_targets_progress = torch.zeros(self.num_envs, max_targets, dtype=torch.float, device=self.device)
        self.footstep_targets_valid = torch.zeros(self.num_envs, max_targets, dtype=torch.bool, device=self.device)
        self.footstep_target_count = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self.footstep_pair_idx = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self.footstep_left_done = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
        self.footstep_right_done = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
        self.footstep_sequence_complete = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
        self.foot_touchdown = torch.zeros(self.num_envs, 2, dtype=torch.bool, device=self.device)
        self.footstep_skip_events = torch.zeros(self.num_envs, 2, dtype=torch.bool, device=self.device)
        self.footstep_hit_count = torch.zeros(self.num_envs, dtype=torch.float, device=self.device)
        self.footstep_skip_count = torch.zeros(self.num_envs, dtype=torch.float, device=self.device)
        self.footstep_no_target_count = torch.zeros(self.num_envs, dtype=torch.float, device=self.device)
        self.footstep_last_skip_xy = torch.zeros(self.num_envs, 2, dtype=torch.float, device=self.device)
        self.footstep_last_touchdown_xy = torch.zeros(self.num_envs, 2, 2, dtype=torch.float, device=self.device)
        self.footstep_touchdown_seen = torch.zeros(self.num_envs, 2, dtype=torch.bool, device=self.device)
        self.footstep_tread_debug_progress = torch.zeros(self.num_envs, max_targets * 2, dtype=torch.float, device=self.device)
        self.footstep_tread_debug_state = torch.zeros(self.num_envs, max_targets * 2, dtype=torch.long, device=self.device)
        self.footstep_tread_debug_count = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self.footstep_skip_vis_counter = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
        self.foot_affordance_candidate_xy = self._build_foot_affordance_candidate_xy()
        self.foot_affordance_labels = torch.zeros(
            self.num_envs, 2, self.foot_affordance_candidate_xy.shape[1], 4,
            dtype=torch.float, device=self.device)
        self._foot_affordance_last_update = -1000000

    def _build_foot_affordance_candidate_xy(self):
        cfg = self._fg_cfg()
        candidate_x = getattr(cfg, "affordance_candidate_x", [0.10, 0.25, 0.40, 0.55, 0.70]) if cfg is not None else [0.10, 0.25, 0.40, 0.55, 0.70]
        y_offsets = getattr(cfg, "affordance_candidate_y_offsets", [-0.08, 0.0, 0.08]) if cfg is not None else [-0.08, 0.0, 0.08]
        lateral = float(getattr(cfg, "affordance_foot_lateral_offset", getattr(cfg, "foot_lateral_offset", 0.11))) if cfg is not None else 0.11
        candidates = []
        for side in (1.0, -1.0):
            side_candidates = []
            for x in candidate_x:
                for y_off in y_offsets:
                    side_candidates.append([float(x), side * lateral + float(y_off)])
            candidates.append(side_candidates)
        return torch.tensor(candidates, dtype=torch.float, device=self.device)

    def _foot_affordance_candidate_centers_world(self, env_ids=None):
        if env_ids is None:
            base_xy = self.root_states[:, :2]
            yaw = self.rpy[:, 2]
        else:
            base_xy = self.root_states[env_ids, :2]
            yaw = self.rpy[env_ids, 2]
        forward = torch.stack([torch.cos(yaw), torch.sin(yaw)], dim=1)
        normal = torch.stack([-torch.sin(yaw), torch.cos(yaw)], dim=1)
        cand = self.foot_affordance_candidate_xy
        centers = (base_xy[:, None, None, :] +
                   cand[None, :, :, 0:1] * forward[:, None, None, :] +
                   cand[None, :, :, 1:2] * normal[:, None, None, :])
        return centers, forward, normal

    def _foot_affordance_box_metrics_batch(self, centers_xy, dir_xy, normal_xy):
        cfg = self._fg_cfg()
        n = centers_xy.shape[0]
        if n == 0:
            empty = torch.empty(0, device=self.device)
            return empty, empty
        length = float(getattr(cfg, "foot_box_length", 0.22))
        width = float(getattr(cfg, "foot_box_width", 0.10))
        samples_l = int(getattr(cfg, "affordance_box_samples_length", 3))
        samples_w = int(getattr(cfg, "affordance_box_samples_width", 3))
        l_offsets = torch.linspace(-0.5 * length, 0.5 * length, samples_l, device=self.device)
        w_offsets = torch.linspace(-0.5 * width, 0.5 * width, samples_w, device=self.device)
        offsets = (l_offsets.view(1, samples_l, 1, 1) * dir_xy.view(n, 1, 1, 2) +
                   w_offsets.view(1, 1, samples_w, 1) * normal_xy.view(n, 1, 1, 2)).reshape(n, -1, 2)
        points = (centers_xy[:, None, :] + offsets).reshape(-1, 2)
        hs = self.terrain.cfg.horizontal_scale
        border = self.terrain.cfg.border_size
        map_x, map_y = self.terrain_safety_map.shape
        px_f = (points[:, 0] + border) / hs
        py_f = (points[:, 1] + border) / hs
        inside = (px_f >= 0) & (px_f <= map_x - 1) & (py_f >= 0) & (py_f <= map_y - 1)
        px = px_f.long().clamp(0, map_x - 1)
        py = py_f.long().clamp(0, map_y - 1)
        safety = self.terrain_safety_map[px, py].reshape(n, -1)
        inside = inside.reshape(n, -1)
        inside_f = inside.float()
        denom = inside_f.sum(dim=1).clamp_min(1.0)
        valid_ratio = inside_f.mean(dim=1)
        safety_mean = (safety * inside_f).sum(dim=1) / denom
        safety_label = torch.clamp(safety_mean * valid_ratio, 0.0, 1.0)
        # Edge risk is intentionally not supervised in the current mainline;
        # terrain_safety_map already encodes unsafe edge/roughness information.
        edge_label = torch.zeros_like(safety_label)
        return safety_label, edge_label

    def _maybe_update_foot_affordance_labels(self, force=False):
        cfg = self._fg_cfg()
        default_interval = int(getattr(getattr(self.cfg, "depth", None), "update_interval", 1))
        interval = int(getattr(cfg, "affordance_label_update_interval", default_interval)) if cfg is not None else default_interval
        interval = max(1, interval)
        if force or self.common_step_counter - self._foot_affordance_last_update >= interval:
            self._update_foot_affordance_labels()
            self._foot_affordance_last_update = int(self.common_step_counter)

    def _update_foot_affordance_labels(self):
        if not hasattr(self, "foot_affordance_labels") or not hasattr(self, "terrain_safety_map"):
            return
        self.foot_affordance_labels.zero_()
        centers, forward, normal = self._foot_affordance_candidate_centers_world()
        n_candidates = centers.shape[2]
        centers_flat = centers.reshape(-1, 2)
        dir_flat = forward[:, None, None, :].expand(self.num_envs, 2, n_candidates, 2).reshape(-1, 2)
        normal_flat = normal[:, None, None, :].expand(self.num_envs, 2, n_candidates, 2).reshape(-1, 2)
        safety_label, edge_label = self._foot_affordance_box_metrics_batch(centers_flat, dir_flat, normal_flat)
        self.foot_affordance_labels[..., 0] = safety_label.reshape(self.num_envs, 2, n_candidates)
        self.foot_affordance_labels[..., 1] = edge_label.reshape(self.num_envs, 2, n_candidates)

        if not self._fg_enabled() or not hasattr(self, "footstep_path_active"):
            return
        active = self.footstep_path_active & ~self.footstep_sequence_complete & (self.footstep_target_count > 0)
        if not active.any():
            return
        env_ids = torch.nonzero(active, as_tuple=False).flatten()
        idx = self.footstep_pair_idx[env_ids].clamp(max=self.footstep_max_targets - 1)
        valid = self.footstep_targets_valid[env_ids, idx]
        if not valid.any():
            return
        env_ids = env_ids[valid]
        idx = idx[valid]
        targets = self.footstep_targets_xy[env_ids, idx]
        env_centers = centers[env_ids]
        dist2 = torch.sum(torch.square(env_centers - targets[:, :, None, :]), dim=-1)
        cfg = self._fg_cfg()
        sigma = float(getattr(cfg, "affordance_target_sigma", getattr(cfg, "target_sigma", 0.12)))
        targetness = torch.exp(-dist2 / (2.0 * sigma * sigma))
        needed = torch.stack([~self.footstep_left_done[env_ids], ~self.footstep_right_done[env_ids]], dim=1).float()
        self.foot_affordance_labels[env_ids, :, :, 2] = targetness
        self.foot_affordance_labels[env_ids, :, :, 3] = needed[:, :, None]

    def _draw_affordance_candidates(self):
        if self.viewer is None or not hasattr(self, "foot_affordance_labels"):
            return
        env_id = self.lookat_id
        if env_id < 0 or env_id >= self.num_envs:
            return
        self._maybe_update_foot_affordance_labels(force=True)
        env_ids = torch.tensor([env_id], dtype=torch.long, device=self.device)
        centers, forward, normal = self._foot_affordance_candidate_centers_world(env_ids)
        labels = self.foot_affordance_labels[env_id]
        for side in range(labels.shape[0]):
            for k in range(labels.shape[1]):
                safety = float(labels[side, k, 0].item())
                targetness = float(labels[side, k, 2].item()) if labels[side, k, 3] > 0 else 0.0
                score = max(safety, targetness)
                color = (1.0 - score, score, 0.15 + 0.35 * targetness)
                self._add_debug_lines(env_id, self._footstep_rect_lines(centers[0, side, k], forward[0], normal[0]), color)

    def _footstep_stair_mask(self, env_ids=None):
        mask = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
        if self._fg_enabled() and hasattr(self, "env_class"):
            stair_class = int(getattr(self._fg_cfg(), "stair_env_class", 4))
            mask = self.env_class.long() == stair_class
        if env_ids is None:
            return mask
        return mask[env_ids]

    def reset_idx(self, env_ids):
        super().reset_idx(env_ids)
        if len(env_ids) == 0:
            return
        self.was_contact[env_ids] = False
        self.last_actions[env_ids] = 0.
        self.last_last_actions[env_ids] = 0.
        self.last_feet_contact_force[env_ids] = 0.
        self.last_last_feet_contact_force[env_ids] = 0.
        self._log_and_reset_footstep_stats(env_ids)
        self._reset_footstep_guidance(env_ids)

    def _log_and_reset_footstep_stats(self, env_ids):
        if not hasattr(self, "footstep_hit_count"):
            return
        if "episode" not in self.extras:
            self.extras["episode"] = {}
        self.extras["episode"]["footstep_hits"] = torch.mean(self.footstep_hit_count[env_ids])
        self.extras["episode"]["footstep_skips"] = torch.mean(self.footstep_skip_count[env_ids])
        self.extras["episode"]["footstep_targets"] = torch.mean(self.footstep_target_count[env_ids].float())
        self.extras["episode"]["footstep_no_target"] = torch.mean(self.footstep_no_target_count[env_ids])
        self.footstep_hit_count[env_ids] = 0.
        self.footstep_skip_count[env_ids] = 0.
        self.footstep_no_target_count[env_ids] = 0.

    def _reset_footstep_guidance(self, env_ids):
        self.footstep_path_active[env_ids] = False
        self.footstep_targets_valid[env_ids] = False
        self.footstep_target_count[env_ids] = 0
        self.footstep_pair_idx[env_ids] = 0
        self.footstep_left_done[env_ids] = False
        self.footstep_right_done[env_ids] = False
        self.footstep_sequence_complete[env_ids] = False
        self.footstep_touchdown_seen[env_ids] = False
        self.footstep_last_touchdown_xy[env_ids] = 0.
        self.footstep_last_skip_xy[env_ids] = 0.
        self.footstep_tread_debug_progress[env_ids] = 0.
        self.footstep_tread_debug_state[env_ids] = 0
        self.footstep_tread_debug_count[env_ids] = 0
        self.footstep_skip_vis_counter[env_ids] = 0
        if hasattr(self, "foot_affordance_labels"):
            self.foot_affordance_labels[env_ids] = 0.
            self._foot_affordance_last_update = -1000000
        if not self._fg_enabled() or not hasattr(self, "terrain"):
            return
        stair_env_ids = env_ids[self._footstep_stair_mask(env_ids)]
        for env_id in stair_env_ids.detach().cpu().tolist():
            self._build_footstep_path_for_env(env_id)
            self._build_footstep_targets_for_env(env_id)
        if stair_env_ids.numel() > 0:
            self._update_path_commands(stair_env_ids)

    def _build_footstep_path_for_env(self, env_id):
        cfg = self._fg_cfg()
        row = int(self.terrain_levels[env_id].item())
        col = int(self.terrain_types[env_id].item())
        terrain_len = float(self.cfg.terrain.terrain_length)
        terrain_width = float(self.cfg.terrain.terrain_width)
        x_end = (row + 1) * terrain_len
        y_center = (col + 0.5) * terrain_width
        start = self.root_states[env_id, :2].detach().clone()
        end_x = x_end - float(getattr(cfg, "path_end_margin", 0.8))
        y_room = terrain_width * 0.5 - float(getattr(cfg, "path_y_margin", 0.45))
        y_room -= float(getattr(cfg, "foot_lateral_offset", 0.11)) + 0.5 * float(getattr(cfg, "foot_box_width", 0.10))
        y_room = max(0.0, min(float(getattr(cfg, "path_end_y_range", 0.35)), y_room))
        end_y = y_center + (2.0 * torch.rand((), device=self.device) - 1.0) * y_room
        end = torch.stack([torch.tensor(end_x, device=self.device), end_y])
        delta = end - start
        path_len = torch.norm(delta).clamp(min=1e-6)
        path_dir = delta / path_len
        path_normal = torch.stack([-path_dir[1], path_dir[0]])
        self.footstep_path_active[env_id] = True
        self.footstep_path_start_xy[env_id] = start
        self.footstep_path_end_xy[env_id] = end
        self.footstep_path_dir_xy[env_id] = path_dir
        self.footstep_path_normal_xy[env_id] = path_normal
        self.footstep_path_len[env_id] = path_len
        self.footstep_path_heading[env_id] = torch.atan2(path_dir[1], path_dir[0])

    def _sample_safety_and_height(self, points_xy):
        hs = self.terrain.cfg.horizontal_scale
        border = self.terrain.cfg.border_size
        map_x, map_y = self.terrain_safety_map.shape
        px_f = (points_xy[:, 0] + border) / hs
        py_f = (points_xy[:, 1] + border) / hs
        inside = (px_f >= 0) & (px_f <= map_x - 1) & (py_f >= 0) & (py_f <= map_y - 1)
        px = px_f.long().clamp(0, map_x - 1)
        py = py_f.long().clamp(0, map_y - 1)
        safety = self.terrain_safety_map[px, py]
        height = self._query_height_at_points(points_xy)
        return safety, height, inside

    def _footstep_box_metrics_batch(self, centers_xy, path_dir, path_normal):
        cfg = self._fg_cfg()
        n = centers_xy.shape[0]
        if n == 0:
            empty = torch.empty(0, device=self.device)
            return empty, empty, empty, empty
        length = float(getattr(cfg, "foot_box_length", 0.22))
        width = float(getattr(cfg, "foot_box_width", 0.10))
        samples_l = int(getattr(cfg, "foot_box_samples_length", 5))
        samples_w = int(getattr(cfg, "foot_box_samples_width", 3))
        l_offsets = torch.linspace(-0.5 * length, 0.5 * length, samples_l, device=self.device)
        w_offsets = torch.linspace(-0.5 * width, 0.5 * width, samples_w, device=self.device)
        offsets = (l_offsets[:, None, None] * path_dir.view(1, 1, 2) +
                   w_offsets[None, :, None] * path_normal.view(1, 1, 2)).reshape(1, -1, 2)
        points = (centers_xy[:, None, :] + offsets).reshape(-1, 2)
        safety, height, inside = self._sample_safety_and_height(points)
        safety = safety.reshape(n, -1)
        height = height.reshape(n, -1)
        inside = inside.reshape(n, -1)
        safety_sorted = torch.sort(safety, dim=1).values
        p10_idx = min(safety.shape[1] - 1, max(0, int(np.floor(0.1 * (safety.shape[1] - 1)))))
        valid_safety = float(getattr(cfg, "valid_sample_safety_thresh", 0.25))
        safety_mean = safety.mean(dim=1)
        safety_p10 = safety_sorted[:, p10_idx]
        height_range = height.max(dim=1).values - height.min(dim=1).values
        valid_ratio = (inside & (safety > valid_safety)).float().mean(dim=1)
        return safety_mean, safety_p10, height_range, valid_ratio

    def _footstep_tread_box_metrics_batch(self, centers_xy, path_dir, path_normal):
        cfg = self._fg_cfg()
        n = centers_xy.shape[0]
        if n == 0:
            empty = torch.empty(0, device=self.device)
            return empty, empty, empty, empty
        length = float(getattr(cfg, "foot_box_length", 0.22))
        width = float(getattr(cfg, "foot_box_width", 0.10))
        samples_l = int(getattr(cfg, "foot_box_samples_length", 5))
        samples_w = int(getattr(cfg, "foot_box_samples_width", 3))
        l_offsets = torch.linspace(-0.5 * length, 0.5 * length, samples_l, device=self.device)
        w_offsets = torch.linspace(-0.5 * width, 0.5 * width, samples_w, device=self.device)
        offsets = (l_offsets[:, None, None] * path_dir.view(1, 1, 2) +
                   w_offsets[None, :, None] * path_normal.view(1, 1, 2)).reshape(1, -1, 2)
        points = (centers_xy[:, None, :] + offsets).reshape(-1, 2)
        hs = self.terrain.cfg.horizontal_scale
        border = self.terrain.cfg.border_size
        map_x, map_y = self.terrain_safety_map.shape
        px_f = (points[:, 0] + border) / hs
        py_f = (points[:, 1] + border) / hs
        inside = (px_f >= 0) & (px_f <= map_x - 1) & (py_f >= 0) & (py_f <= map_y - 1)
        px = px_f.long().clamp(0, map_x - 1)
        py = py_f.long().clamp(0, map_y - 1)
        safety = self.terrain_safety_map[px, py].reshape(n, -1)
        height = (self.height_samples[px, py].float() * self.terrain.cfg.vertical_scale).reshape(n, -1)
        inside = inside.reshape(n, -1)
        safety_sorted = torch.sort(safety, dim=1).values
        p10_idx = min(safety.shape[1] - 1, max(0, int(np.floor(0.1 * (safety.shape[1] - 1)))))
        valid_safety = float(getattr(cfg, "tread_valid_sample_safety_thresh", getattr(cfg, "valid_sample_safety_thresh", 0.25)))
        safety_mean = safety.mean(dim=1)
        safety_p10 = safety_sorted[:, p10_idx]
        height_range = height.max(dim=1).values - height.min(dim=1).values
        valid_ratio = (inside & (safety > valid_safety)).float().mean(dim=1)
        return safety_mean, safety_p10, height_range, valid_ratio

    def _build_footstep_targets_for_env(self, env_id):
        cfg = self._fg_cfg()
        self.footstep_targets_valid[env_id] = False
        self.footstep_target_count[env_id] = 0
        self.footstep_tread_debug_progress[env_id] = 0.
        self.footstep_tread_debug_state[env_id] = 0
        self.footstep_tread_debug_count[env_id] = 0
        path_len = float(self.footstep_path_len[env_id].item())
        start_offset = float(getattr(cfg, "target_start_offset", 0.25))
        end_margin = float(getattr(cfg, "target_end_margin", 0.6))
        profile_spacing = float(getattr(cfg, "tread_profile_spacing", getattr(cfg, "scan_spacing", 0.05)))
        if path_len <= start_offset + end_margin:
            self.footstep_no_target_count[env_id] += 1.0
            return
        progress = torch.arange(start_offset, path_len - end_margin, profile_spacing, device=self.device)
        if progress.numel() < 2:
            self.footstep_no_target_count[env_id] += 1.0
            return

        path_dir = self.footstep_path_dir_xy[env_id]
        path_normal = self.footstep_path_normal_xy[env_id]
        centers = self.footstep_path_start_xy[env_id].unsqueeze(0) + progress[:, None] * path_dir.unsqueeze(0)
        hs = self.terrain.cfg.horizontal_scale
        border = self.terrain.cfg.border_size
        px = ((centers[:, 0] + border) / hs).long().clamp(0, self.height_samples.shape[0] - 1)
        py = ((centers[:, 1] + border) / hs).long().clamp(0, self.height_samples.shape[1] - 1)
        center_heights = self.height_samples[px, py].float() * self.terrain.cfg.vertical_scale
        edge_thresh = float(getattr(cfg, "tread_edge_height_thresh", 0.025))
        height_delta = torch.abs(center_heights[1:] - center_heights[:-1])
        edge_idx = torch.nonzero(height_delta > edge_thresh, as_tuple=False).flatten().detach().cpu().tolist()
        if len(edge_idx) == 0:
            self.footstep_no_target_count[env_id] += 1.0
            return

        edge_bands = []
        band_start = edge_idx[0]
        band_end = edge_idx[0]
        for idx in edge_idx[1:]:
            if idx <= band_end + 1:
                band_end = idx
            else:
                edge_bands.append((band_start, band_end))
                band_start = idx
                band_end = idx
        edge_bands.append((band_start, band_end))

        segments = []
        seg_start = 0
        has_prev_edge = False
        for band_start, band_end in edge_bands:
            seg_end = max(seg_start, band_start)
            segments.append((seg_start, seg_end, has_prev_edge, True))
            seg_start = min(progress.numel() - 1, band_end + 1)
            has_prev_edge = True
        if seg_start < progress.numel():
            segments.append((seg_start, progress.numel() - 1, has_prev_edge, False))

        lateral = float(getattr(cfg, "foot_lateral_offset", 0.11))
        half_l = 0.5 * float(getattr(cfg, "foot_box_length", 0.22))
        edge_margin = float(getattr(cfg, "tread_edge_margin", 0.015))
        bounded_margin = half_l + edge_margin
        min_tread_length = float(getattr(cfg, "min_tread_length", 0.20))
        include_start_platform = bool(getattr(cfg, "include_start_platform_target", False))
        include_end_platform = bool(getattr(cfg, "include_end_platform_target", True))
        min_spacing = float(getattr(cfg, "min_pair_spacing", 0.22))
        max_targets = self.footstep_max_targets
        count = 0
        last_s = -1e6
        debug_progress = []
        debug_state = []  # 1 accepted, 2 metric rejected, 3 geometry rejected

        for seg_start, seg_end, has_prev_edge, has_next_edge in segments:
            if seg_end <= seg_start:
                continue
            if not has_prev_edge and not include_start_platform:
                continue
            if not has_next_edge and not include_end_platform:
                continue
            seg_s0 = float(progress[seg_start].item())
            seg_s1 = float(progress[seg_end].item())
            seg_len = seg_s1 - seg_s0
            mid_s = 0.5 * (seg_s0 + seg_s1)
            if seg_len < min_tread_length:
                debug_progress.append(mid_s)
                debug_state.append(3)
                continue

            lo = seg_s0 + (bounded_margin if has_prev_edge else 0.0)
            hi = seg_s1 - (bounded_margin if has_next_edge else 0.0)
            if hi < lo:
                debug_progress.append(mid_s)
                debug_state.append(3)
                continue
            s_candidate = 0.5 * (lo + hi)
            if s_candidate - last_s < min_spacing:
                debug_progress.append(s_candidate)
                debug_state.append(3)
                continue

            center = self.footstep_path_start_xy[env_id] + s_candidate * path_dir
            left_center = (center + lateral * path_normal).view(1, 2)
            right_center = (center - lateral * path_normal).view(1, 2)
            l_mean, l_p10, l_hrange, l_vratio = self._footstep_tread_box_metrics_batch(left_center, path_dir, path_normal)
            r_mean, r_p10, r_hrange, r_vratio = self._footstep_tread_box_metrics_batch(right_center, path_dir, path_normal)
            pair_valid = (
                (l_mean[0] > float(getattr(cfg, "tread_safety_mean_thresh", getattr(cfg, "safety_mean_thresh", 0.70)))) &
                (r_mean[0] > float(getattr(cfg, "tread_safety_mean_thresh", getattr(cfg, "safety_mean_thresh", 0.70)))) &
                (l_p10[0] > float(getattr(cfg, "tread_safety_p10_thresh", getattr(cfg, "safety_p10_thresh", 0.45)))) &
                (r_p10[0] > float(getattr(cfg, "tread_safety_p10_thresh", getattr(cfg, "safety_p10_thresh", 0.45)))) &
                (l_hrange[0] < float(getattr(cfg, "tread_height_range_thresh", getattr(cfg, "height_range_thresh", 0.05)))) &
                (r_hrange[0] < float(getattr(cfg, "tread_height_range_thresh", getattr(cfg, "height_range_thresh", 0.05)))) &
                (l_vratio[0] > float(getattr(cfg, "tread_valid_ratio_thresh", getattr(cfg, "valid_ratio_thresh", 0.75)))) &
                (r_vratio[0] > float(getattr(cfg, "tread_valid_ratio_thresh", getattr(cfg, "valid_ratio_thresh", 0.75))))
            )
            if not bool(pair_valid.item()):
                debug_progress.append(s_candidate)
                debug_state.append(2)
                continue

            if count >= max_targets:
                break
            self.footstep_targets_xy[env_id, count, 0] = left_center[0]
            self.footstep_targets_xy[env_id, count, 1] = right_center[0]
            self.footstep_targets_progress[env_id, count] = s_candidate
            self.footstep_targets_valid[env_id, count] = True
            debug_progress.append(s_candidate)
            debug_state.append(1)
            last_s = s_candidate
            count += 1

        debug_max = self.footstep_tread_debug_progress.shape[1]
        debug_count = min(len(debug_progress), debug_max)
        if debug_count > 0:
            self.footstep_tread_debug_progress[env_id, :debug_count] = torch.tensor(debug_progress[:debug_count], dtype=torch.float, device=self.device)
            self.footstep_tread_debug_state[env_id, :debug_count] = torch.tensor(debug_state[:debug_count], dtype=torch.long, device=self.device)
            self.footstep_tread_debug_count[env_id] = debug_count

        self.footstep_target_count[env_id] = count
        if count == 0:
            self.footstep_no_target_count[env_id] += 1.0
        elif getattr(cfg, "save_topdown_debug", False):
            lookat_id = int(getattr(self, "lookat_id", 0))
            if env_id == lookat_id:
                self._save_footstep_topdown_debug(env_id)

    def _update_path_commands(self, env_ids=None):
        if not self._fg_enabled() or not hasattr(self, "footstep_path_active"):
            return
        if env_ids is None:
            ids = torch.nonzero(self.footstep_path_active, as_tuple=False).flatten()
        else:
            ids = env_ids[self.footstep_path_active[env_ids]]
        if ids.numel() == 0:
            return
        cfg = self._fg_cfg()
        base_xy = self.root_states[ids, :2]
        start = self.footstep_path_start_xy[ids]
        path_dir = self.footstep_path_dir_xy[ids]
        path_normal = self.footstep_path_normal_xy[ids]
        lateral_error = torch.sum((base_xy - start) * path_normal, dim=1)
        forward_speed = float(getattr(cfg, "path_forward_speed", 0.35))
        correction = -float(getattr(cfg, "path_lateral_gain", 0.8)) * lateral_error
        correction = torch.clamp(correction, -float(getattr(cfg, "path_lateral_speed_clip", 0.35)), float(getattr(cfg, "path_lateral_speed_clip", 0.35)))
        v_world_xy = forward_speed * path_dir + correction[:, None] * path_normal
        v_world = torch.cat([v_world_xy, torch.zeros(ids.numel(), 1, device=self.device)], dim=1)
        v_body = quat_rotate_inverse(self.base_quat[ids], v_world)[:, :2]
        lin_x_min, lin_x_max = sorted(self.command_ranges["lin_vel_x"])
        lin_y_min, lin_y_max = sorted(self.command_ranges["lin_vel_y"])
        self.commands[ids, 0] = torch.clamp(v_body[:, 0], lin_x_min, lin_x_max)
        self.commands[ids, 1] = torch.clamp(v_body[:, 1], lin_y_min, lin_y_max)
        heading = self.footstep_path_heading[ids]
        forward = quat_apply(self.base_quat[ids], self.forward_vec[ids])
        current_heading = torch.atan2(forward[:, 1], forward[:, 0])
        yaw_error = wrap_to_pi(heading - current_heading)
        yaw_min, yaw_max = sorted(self.command_ranges["ang_vel_yaw"])
        yaw_cmd = torch.clamp(float(getattr(cfg, "path_heading_gain", 0.5)) * yaw_error, yaw_min, yaw_max)
        self.commands[ids, 2] = yaw_cmd
        self.commands[ids, 3] = heading

    def _draw_foot_indicator(self):
        self.gym.clear_lines(self.viewer)
        sphere_geom = gymutil.WireframeSphereGeometry(0.01, 10, 10, None, color=(1, 0, 0))
        indicator_pos = self.feet_indicator_pos.reshape(-1, 3)
        for i, point in enumerate(indicator_pos):
            pose = gymapi.Transform(gymapi.Vec3(point[0], point[1], point[2]), r=None)
            gymutil.draw_lines(
                sphere_geom, self.gym, self.viewer, self.envs[self.lookat_id], pose
            )

    def _line_height_points(self, points_xy, z_offset=0.035):
        z = self._query_height_at_points(points_xy).unsqueeze(1) + z_offset
        return torch.cat([points_xy, z], dim=1)

    def _add_debug_lines(self, env_id, line_points, color):
        if len(line_points) == 0:
            return
        vertices = torch.stack(line_points, dim=0).detach().cpu().numpy().astype(np.float32)
        colors = np.tile(np.array(color, dtype=np.float32), (vertices.shape[0] // 2, 1))
        self.gym.add_lines(self.viewer, self.envs[env_id], vertices.shape[0] // 2, vertices, colors)

    def _footstep_rect_lines(self, center_xy, path_dir, path_normal):
        cfg = self._fg_cfg()
        half_l = 0.5 * float(getattr(cfg, "foot_box_length", 0.22))
        half_w = 0.5 * float(getattr(cfg, "foot_box_width", 0.10))
        corners_xy = torch.stack([
            center_xy + half_l * path_dir + half_w * path_normal,
            center_xy + half_l * path_dir - half_w * path_normal,
            center_xy - half_l * path_dir - half_w * path_normal,
            center_xy - half_l * path_dir + half_w * path_normal,
        ], dim=0)
        corners = self._line_height_points(corners_xy)
        return [corners[0], corners[1], corners[1], corners[2], corners[2], corners[3], corners[3], corners[0]]

    def _draw_target_sphere(self, env_id, xy, color, radius=0.035):
        point = self._line_height_points(xy.view(1, 2), z_offset=0.055)[0].detach().cpu().numpy()
        geom = gymutil.WireframeSphereGeometry(radius, 8, 8, None, color=color)
        pose = gymapi.Transform(gymapi.Vec3(float(point[0]), float(point[1]), float(point[2])), r=None)
        gymutil.draw_lines(geom, self.gym, self.viewer, self.envs[env_id], pose)

    def _draw_footstep_targets(self):
        if self.viewer is None or not self._fg_enabled() or not hasattr(self, "footstep_path_active"):
            return
        env_id = int(self.lookat_id) if hasattr(self, "lookat_id") else 0
        if env_id < 0 or env_id >= self.num_envs:
            return
        if not bool(self.footstep_path_active[env_id].item()):
            return
        if not getattr(self.cfg.terrain, "visualize_safety_map", False):
            self.gym.clear_lines(self.viewer)
        path_points = self._line_height_points(torch.stack([
            self.footstep_path_start_xy[env_id],
            self.footstep_path_end_xy[env_id],
        ], dim=0), z_offset=0.06)
        self._add_debug_lines(env_id, [path_points[0], path_points[1]], (0.0, 0.9, 1.0))
        if self.footstep_target_count[env_id] <= 0 or self.footstep_sequence_complete[env_id]:
            return
        idx = int(self.footstep_pair_idx[env_id].item())
        if idx >= self.footstep_max_targets or not bool(self.footstep_targets_valid[env_id, idx].item()):
            return
        path_dir = self.footstep_path_dir_xy[env_id]
        path_normal = self.footstep_path_normal_xy[env_id]
        left_xy = self.footstep_targets_xy[env_id, idx, 0]
        right_xy = self.footstep_targets_xy[env_id, idx, 1]
        left_color = (0.0, 1.0, 0.0) if bool(self.footstep_left_done[env_id].item()) else (0.1, 0.35, 1.0)
        right_color = (0.0, 1.0, 0.0) if bool(self.footstep_right_done[env_id].item()) else (1.0, 0.55, 0.0)
        self._add_debug_lines(env_id, self._footstep_rect_lines(left_xy, path_dir, path_normal), left_color)
        self._add_debug_lines(env_id, self._footstep_rect_lines(right_xy, path_dir, path_normal), right_color)
        self._draw_target_sphere(env_id, 0.5 * (left_xy + right_xy), (0.0, 1.0, 1.0), radius=0.025)
        if bool(self.footstep_left_done[env_id].item()):
            self._draw_target_sphere(env_id, left_xy, (0.0, 1.0, 0.0), radius=0.025)
        if bool(self.footstep_right_done[env_id].item()):
            self._draw_target_sphere(env_id, right_xy, (0.0, 1.0, 0.0), radius=0.025)
        if self.footstep_skip_vis_counter[env_id] > 0:
            self._draw_target_sphere(env_id, self.footstep_last_skip_xy[env_id], (1.0, 0.0, 0.0), radius=0.04)
            self.footstep_skip_vis_counter[env_id] -= 1

    def _maybe_save_footstep_topdown_debug(self):
        if not self._fg_enabled() or not getattr(self._fg_cfg(), "save_topdown_debug", False):
            return
        interval = int(getattr(self._fg_cfg(), "topdown_debug_interval", 100))
        if interval <= 0 or self.common_step_counter % interval != 0:
            return
        env_id = int(self.lookat_id) if hasattr(self, "lookat_id") else 0
        if 0 <= env_id < self.num_envs and bool(self.footstep_path_active[env_id].item()):
            self._save_footstep_topdown_debug(env_id)

    def _save_footstep_topdown_debug(self, env_id):
        cfg = self._fg_cfg()
        if not hasattr(self, "terrain_safety_map"):
            return
        row = int(self.terrain_levels[env_id].item())
        col = int(self.terrain_types[env_id].item())
        border_px = self.terrain.border
        len_px = self.terrain.length_per_env_pixels
        wid_px = self.terrain.width_per_env_pixels
        start_x = border_px + row * len_px
        end_x = start_x + len_px
        start_y = border_px + col * wid_px
        end_y = start_y + wid_px
        patch = self.terrain_safety_map[start_x:end_x, start_y:end_y].detach().cpu().numpy()
        img = np.clip(patch, 0.0, 1.0)
        img = (img * 255).astype(np.uint8)
        img = cv2.applyColorMap(img, cv2.COLORMAP_VIRIDIS)
        scale = int(getattr(cfg, "topdown_scale", 2))
        img = cv2.resize(img, (img.shape[1] * scale, img.shape[0] * scale), interpolation=cv2.INTER_NEAREST)
        hs = self.terrain.cfg.horizontal_scale
        border_m = self.terrain.cfg.border_size
        def xy_to_pix(xy):
            px = int(round(((float(xy[0]) + border_m) / hs - start_x) * scale))
            py = int(round(((float(xy[1]) + border_m) / hs - start_y) * scale))
            return py, px
        p0 = xy_to_pix(self.footstep_path_start_xy[env_id])
        p1 = xy_to_pix(self.footstep_path_end_xy[env_id])
        cv2.line(img, p0, p1, (255, 255, 255), 1)
        debug_count = int(self.footstep_tread_debug_count[env_id].item()) if hasattr(self, "footstep_tread_debug_count") else 0
        for i in range(debug_count):
            state = int(self.footstep_tread_debug_state[env_id, i].item())
            s_dbg = self.footstep_tread_debug_progress[env_id, i]
            xy = self.footstep_path_start_xy[env_id] + s_dbg * self.footstep_path_dir_xy[env_id]
            pix = xy_to_pix(xy)
            if state == 1:
                color = (80, 220, 80)
            elif state == 2:
                color = (0, 0, 255)
            else:
                color = (128, 128, 128)
            cv2.circle(img, pix, 1, color, -1)
        count = int(self.footstep_target_count[env_id].item())
        for i in range(count):
            l = xy_to_pix(self.footstep_targets_xy[env_id, i, 0])
            r = xy_to_pix(self.footstep_targets_xy[env_id, i, 1])
            cv2.circle(img, l, 2, (255, 0, 0), -1)
            cv2.circle(img, r, 2, (0, 165, 255), -1)
        if count > 0 and not bool(self.footstep_sequence_complete[env_id].item()):
            idx = min(int(self.footstep_pair_idx[env_id].item()), count - 1)
            l = xy_to_pix(self.footstep_targets_xy[env_id, idx, 0])
            r = xy_to_pix(self.footstep_targets_xy[env_id, idx, 1])
            cv2.circle(img, l, 4, (255, 255, 255), 1)
            cv2.circle(img, r, 4, (255, 255, 255), 1)
        base = xy_to_pix(self.root_states[env_id, :2])
        cv2.circle(img, base, 3, (255, 255, 255), -1)
        for foot_id, color in enumerate(((255, 0, 0), (0, 165, 255))):
            if bool(self.footstep_touchdown_seen[env_id, foot_id].item()):
                td = xy_to_pix(self.footstep_last_touchdown_xy[env_id, foot_id])
                cv2.drawMarker(img, td, color, markerType=cv2.MARKER_CROSS, markerSize=6, thickness=1)
        if self.footstep_skip_vis_counter[env_id] > 0:
            skip = xy_to_pix(self.footstep_last_skip_xy[env_id])
            cv2.circle(img, skip, 5, (0, 0, 255), 1)
        out_dir = getattr(cfg, "topdown_debug_dir", "logs/footstep_debug")
        os.makedirs(out_dir, exist_ok=True)
        cv2.imwrite(os.path.join(out_dir, f"footstep_env{env_id:04d}_{self.common_step_counter:08d}.png"), img)

    def _reset_dofs(self, env_ids):
        if self.cfg.init_state.random_default_pos:
            rand_default_pos = self.motion_reference[np.random.randint(0, self.motion_reference.shape[0], size=(env_ids.shape[0], )), :]
            self.dof_pos[env_ids] = rand_default_pos * torch_rand_float(0.5, 1.5, (len(env_ids), self.num_dof), device=self.device)
        else:
            self.dof_pos[env_ids] = self.default_dof_pos * torch_rand_float(0.5, 1.5, (len(env_ids), self.num_dof), device=self.device)
        self.dof_vel[env_ids] = 0.

        env_ids_int32 = env_ids.to(dtype=torch.int32)
        self.gym.set_dof_state_tensor_indexed(self.sim,
                                              gymtorch.unwrap_tensor(self.dof_state),
                                              gymtorch.unwrap_tensor(env_ids_int32), len(env_ids_int32))

    def post_physics_step(self):
        """ check terminations, compute observations and rewards
            calls self._post_physics_step_callback() for common computations 
            calls self._draw_debug_vis() if needed
        """
        self.gym.refresh_actor_root_state_tensor(self.sim)
        self.gym.refresh_net_contact_force_tensor(self.sim)
        self.gym.refresh_force_sensor_tensor(self.sim)
        self.gym.refresh_rigid_body_state_tensor(self.sim)

        self.episode_length_buf += 1
        self.common_step_counter += 1

        # prepare quantities
        self.base_pos[:] = self.root_states[:, 0:3]
        self.base_quat[:] = self.root_states[:, 3:7]
        self.rpy[:] = get_euler_xyz_in_tensor(self.base_quat[:])
        self.base_lin_vel[:] = quat_rotate_inverse(self.base_quat, self.root_states[:, 7:10])
        self.base_ang_vel[:] = quat_rotate_inverse(self.base_quat, self.root_states[:, 10:13])
        self.projected_gravity[:] = quat_rotate_inverse(self.base_quat, self.gravity_vec)

        self.feet_pos = self.rigid_body_states.view(self.num_envs, self.num_bodies, 13)[:, self.feet_indices, 0:3]
        self.feet_vel = self.rigid_body_states.view(self.num_envs, self.num_bodies, 13)[:, self.feet_indices, 7:10]

        contact = self.contact_forces[:, self.feet_indices, 2] > 1.
        self.contact_filt = torch.logical_or(contact, self.last_contacts)
        self.contact_over = torch.logical_and(~contact, self.last_contacts)
        self.last_contacts = contact

        # compute observations, rewards, resets, ...
        self.check_termination()
        self.compute_reward()
        env_ids = self.reset_buf.nonzero(as_tuple=False).flatten()
        terminal_amp_states = self.get_amp_observations()[env_ids]
        terminal_obs, terminal_critic_obs = self.compute_observations()
        self.reset_idx(env_ids)

        self.update_depth_buffer()
        self.warp_update_depth_buffer()

        self._post_physics_step_callback()
        
        if self.cfg.domain_rand.push_robots:
            self._push_robots()

        self.compute_observations() # in some cases a simulation step might be required to refresh some obs (for example body positions)
        
        self.last_last_actions[:] = torch.clone(self.last_actions[:])
        self.last_actions[:] = self.actions[:]
        self.last_last_feet_contact_force[:] = torch.clone(self.last_feet_contact_force[:])
        self.last_feet_contact_force[:] = self.contact_forces[:, self.feet_indices]

        self.last_dof_vel[:] = self.dof_vel[:]
        self.last_root_vel[:] = self.root_states[:, 7:13]

        if self.viewer and self.enable_viewer_sync and self.debug_viz:
            if self.cfg.depth.use_camera and self.cfg.depth.warp_camera:
                window_name = "Depth Image"
                cv2.namedWindow(window_name, cv2.WINDOW_NORMAL)
                cv2.imshow("Depth Image", self.depth_buffer[self.lookat_id, -1].cpu().numpy() + 0.5)
                cv2.waitKey(1)
                window_name = "Warp Depth Image"
                cv2.namedWindow(window_name, cv2.WINDOW_NORMAL)
                cv2.imshow("Warp Depth Image", self.warp_depth_buffer[self.lookat_id, -1].cpu().numpy() + 0.5)
                cv2.waitKey(1)
            elif self.cfg.depth.warp_camera:
                window_name = "Warp Depth Image"
                cv2.namedWindow(window_name, cv2.WINDOW_NORMAL)
                cv2.imshow("Warp Depth Image", self.warp_depth_buffer[self.lookat_id, -1].cpu().numpy() + 0.5)
                cv2.waitKey(1)
            elif self.cfg.depth.use_camera:
                window_name = "Depth Image"
                cv2.namedWindow(window_name, cv2.WINDOW_NORMAL)
                cv2.imshow("Depth Image", self.depth_buffer[self.lookat_id, -1].cpu().numpy() + 0.5)
                cv2.waitKey(1)

            # self._draw_foot_indicator()

        self._maybe_save_footstep_topdown_debug()
    
        return env_ids, terminal_amp_states, terminal_obs[env_ids], terminal_critic_obs[env_ids]

    def _post_physics_step_callback(self):
        self.compute_both_feet_info()
        self.compute_feet_indicator_pos()
        super()._post_physics_step_callback()
        self._update_path_commands()
    
    def compute_both_feet_info(self):
        # compute both feet swing length
        cur_footpos_translated = self.feet_pos - self.root_states[:, 0:3].unsqueeze(1)
        cur_footvel_translated = self.feet_vel - self.root_states[:, 7:10].unsqueeze(1)
        for i in range(len(self.feet_indices)):
            self.footpos_in_body_frame[:, i, :] = quat_rotate_inverse(self.base_quat, cur_footpos_translated[:, i, :])
            self.footvel_in_body_frame[:, i, :] = quat_rotate_inverse(self.base_quat, cur_footvel_translated[:, i, :])
    
    def compute_feet_indicator_pos(self):
        num_dot = self.feet_indicator_offset.shape[0]
        ankle_quat = self.rigid_body_states.view(self.num_envs, self.num_bodies, 13)[:, self.feet_indices, 3:7]
        feet_offset = self.feet_indicator_offset.view(1, 1, num_dot, 3).expand(self.num_envs, 2, num_dot, 3)
        quat_expanded = ankle_quat.unsqueeze(2).expand(-1, -1, num_dot, -1)  # (num_envs, 2, num_dot, 4)
        rotated_points = quat_apply(quat_expanded.reshape(-1, 4), feet_offset.reshape(-1, 3))
        rotated_points = rotated_points.view(self.num_envs, 2, num_dot, 3)
        self.feet_indicator_pos = rotated_points + self.feet_pos.unsqueeze(2)  # (num_envs, 2, num_dot, 3)

    
    def check_termination(self):
        """ Check if environments need to be reset
        """
        self.reset_buf = torch.any(torch.norm(self.contact_forces[:, self.termination_contact_indices, :], dim=-1) > 1000., dim=1)
        self.reset_buf |= torch.logical_or(torch.abs(self.rpy[:,1])>1.0, torch.abs(self.rpy[:,0])>0.8)
        self.reset_buf |= (self._get_base_heights() < 0.4)

        if self.cfg.terrain.mesh_type == "trimesh":
            offset_y = torch.abs(self.root_states[:, 1] - self.origin_y)
            only_forward_env = torch.logical_and(self.env_class != 0, self.env_class != 1)
            self.reset_buf |= torch.logical_and(only_forward_env, offset_y>1.0)
        
        self.time_out_buf = self.episode_length_buf > self.max_episode_length # no terminal reward for time-outs
        self.reset_buf |= self.time_out_buf

    
    def compute_observations(self):
        """ Computes observations
        """
        self.obs_buf = torch.cat((  self.commands[:, :3] * self.commands_scale,
                                    self.base_ang_vel * self.obs_scales.ang_vel,
                                    self.projected_gravity,
                                    (self.dof_pos - self.default_dof_pos) * self.obs_scales.dof_pos,
                                    self.dof_vel * self.obs_scales.dof_vel,
                                    self.actions,
                                    ),dim=-1)
        
        self.privileged_obs_buf = torch.cat((  self.base_lin_vel * self.obs_scales.lin_vel,
                                    self.base_ang_vel  * self.obs_scales.ang_vel,
                                    self.projected_gravity,
                                    self.commands[:, :3] * self.commands_scale,
                                    (self.dof_pos - self.default_dof_pos) * self.obs_scales.dof_pos,
                                    self.dof_vel * self.obs_scales.dof_vel,
                                    self.actions,
                                    ),dim=-1)

        if self.cfg.env.feet_info:  # 6 * 2 = 12
            self.privileged_obs_buf = torch.cat((self.privileged_obs_buf, self.footpos_in_body_frame.reshape(self.num_envs, -1), 
                                                 self.footvel_in_body_frame.reshape(self.num_envs, -1)), dim=-1)
        
        if self.cfg.env.foot_force_info:  # 6
            contact_force = self.sensor_forces.flatten(1) * self.obs_scales.contact_force
            self.privileged_obs_buf = torch.cat((self.privileged_obs_buf, contact_force), dim=-1)
        
        if self.cfg.env.priv_info:  # 32 + 1 + 1 + 1 + 3 = 38
            self.privileged_obs_buf= torch.cat((self.privileged_obs_buf, self.root_states[:, 2].unsqueeze(-1)), dim=-1)

            if self.cfg.domain_rand.randomize_friction:  # 1
                self.privileged_obs_buf= torch.cat((self.privileged_obs_buf, self.randomized_frictions), dim=-1)

            if (self.cfg.domain_rand.randomize_base_mass):  # 1
                self.privileged_obs_buf = torch.cat((self.privileged_obs_buf, self.randomized_added_masses), dim=-1)

            if (self.cfg.domain_rand.randomize_com_pos):  # 3
                self.privileged_obs_buf = torch.cat((self.privileged_obs_buf, self.randomized_com_pos * self.obs_scales.com_pos), dim=-1)

            if (self.cfg.domain_rand.randomize_gains):  # 16 * 2
                self.privileged_obs_buf = torch.cat((self.privileged_obs_buf, (self.randomized_p_gains / self.p_gains - 1) * self.obs_scales.pd_gains), dim=-1)
                self.privileged_obs_buf = torch.cat((self.privileged_obs_buf, (self.randomized_d_gains / self.d_gains - 1) * self.obs_scales.pd_gains), dim=-1)
        
        if self.cfg.terrain.measure_heights:  # 187
            heights = torch.clip(self.root_states[:, 2].unsqueeze(1) - self.cfg.normalization.base_height - self.measured_heights, -1, 1.) * self.obs_scales.height_measurements
            self.privileged_obs_buf = torch.cat((self.privileged_obs_buf, heights), dim=-1)

        # add perceptive inputs if not blind
        # add noise if needed
        if self.add_noise:
            self.obs_buf += (2 * torch.rand_like(self.obs_buf) - 1) * self.noise_scale_vec

        return self.obs_buf, self.privileged_obs_buf

    def compute_reward(self):
        """ Compute rewards
            Calls each reward function which had a non-zero scale (processed in self._prepare_reward_function())
            adds each terms to the episode sums and to the total reward
        """
        self._prepare_touchdown_rewards()
        self.rew_buf[:] = 0.
        for i in range(len(self.reward_functions)):
            name = self.reward_names[i]
            rew = self.reward_functions[i]() * self.reward_scales[name]
            self.rew_buf += rew
            self.episode_sums[name] += rew
        if self.cfg.rewards.only_positive_rewards:
            self.rew_buf[:] = torch.clip(self.rew_buf[:], min=0.)
        # add termination reward after clipping
        if "termination" in self.reward_scales:
            rew = self._reward_termination() * self.reward_scales["termination"]
            self.rew_buf += rew
            self.episode_sums["termination"] += rew
        self.was_contact = self.contact_filt.clone()

    def _prepare_touchdown_rewards(self):
        self.foot_touchdown = self.contact_filt & ~self.was_contact
        self.footstep_skip_events.zero_()
        if hasattr(self, "feet_pos") and self.foot_touchdown.any():
            self.footstep_last_touchdown_xy[self.foot_touchdown] = self.feet_pos[:, :, :2][self.foot_touchdown]
            self.footstep_touchdown_seen |= self.foot_touchdown
        if not self._fg_enabled() or not hasattr(self, "feet_pos"):
            return
        active = self.footstep_path_active & ~self.footstep_sequence_complete & (self.footstep_target_count > 0)
        if not active.any():
            return
        env_ids = torch.nonzero(active, as_tuple=False).flatten()
        idx = self.footstep_pair_idx[env_ids].clamp(max=self.footstep_max_targets - 1)
        current_progress = self.footstep_targets_progress[env_ids, idx]
        base_progress = torch.sum((self.root_states[env_ids, :2] - self.footstep_path_start_xy[env_ids]) * self.footstep_path_dir_xy[env_ids], dim=1)
        miss_margin = float(getattr(self._fg_cfg(), "target_auto_advance_margin", getattr(self._fg_cfg(), "skip_progress_margin", 0.18)))
        missed = base_progress > current_progress + miss_margin
        missed_envs = env_ids[missed]
        if missed_envs.numel() > 0:
            next_idx = self.footstep_pair_idx[missed_envs] + 1
            has_next = next_idx < self.footstep_target_count[missed_envs]
            advance_envs = missed_envs[has_next]
            complete_envs = missed_envs[~has_next]
            if advance_envs.numel() > 0:
                self.footstep_pair_idx[advance_envs] += 1
                self.footstep_left_done[advance_envs] = False
                self.footstep_right_done[advance_envs] = False
            if complete_envs.numel() > 0:
                self.footstep_sequence_complete[complete_envs] = True
            active = self.footstep_path_active & ~self.footstep_sequence_complete & (self.footstep_target_count > 0)
            env_ids = torch.nonzero(active, as_tuple=False).flatten()
            if env_ids.numel() == 0:
                return
            idx = self.footstep_pair_idx[env_ids].clamp(max=self.footstep_max_targets - 1)
            current_progress = self.footstep_targets_progress[env_ids, idx]
        feet_xy = self.feet_pos[env_ids, :, :2]
        foot_progress = torch.sum((feet_xy - self.footstep_path_start_xy[env_ids, None, :]) * self.footstep_path_dir_xy[env_ids, None, :], dim=-1)
        skip_margin = float(getattr(self._fg_cfg(), "skip_progress_margin", 0.18))
        skip = self.foot_touchdown[env_ids] & (foot_progress > current_progress[:, None] + skip_margin)
        self.footstep_skip_events[env_ids] = skip
        skip_envs = env_ids[skip.any(dim=1)]
        if skip_envs.numel() > 0:
            self.footstep_skip_count[skip_envs] += skip[skip.any(dim=1)].float().sum(dim=1)
            first_skip_side = skip[skip.any(dim=1)].float().argmax(dim=1)
            self.footstep_last_skip_xy[skip_envs] = feet_xy[skip.any(dim=1), first_skip_side]
            self.footstep_skip_vis_counter[skip_envs] = int(getattr(self._fg_cfg(), "skip_vis_steps", 30))

    def _resample_commands(self, env_ids):
        """ Randommly select commands of some environments

        Args:
            env_ids (List[int]): Environments ids for which new commands are needed
        """
        super()._resample_commands(env_ids)

        only_forward_env = torch.logical_and(self.env_class != 0, self.env_class != 1)
        self.commands[only_forward_env, 3] = 0
        self.commands[only_forward_env, 2] = 0
        self.commands[only_forward_env, 1] = 0
        self.commands[only_forward_env, 0] = torch.abs(self.commands[only_forward_env, 0])
        self._update_path_commands(env_ids)
    
    #------------ reward functions----------------
    def _reward_tracking_lin_vel(self):
        # Tracking of linear velocity commands (xy axes)
        lin_vel_error = torch.sum(torch.square(self.commands[:, :2] - self.base_lin_vel[:, :2]), dim=1)
        return torch.exp(-lin_vel_error/self.cfg.rewards.tracking_sigma)
    
    def _reward_tracking_ang_vel(self):
        # Tracking of angular velocity commands (yaw) 
        ang_vel_error = torch.square(self.commands[:, 2] - self.base_ang_vel[:, 2])
        return torch.exp(-ang_vel_error/self.cfg.rewards.tracking_sigma)
    
    def _reward_dof_acc(self):
        # Penalize dof accelerations
        return torch.sum(torch.square((self.last_dof_vel - self.dof_vel) / self.dt), dim=1)
    
    def _reward_dof_vel(self):
        # Penalize dof velocities
        return torch.sum(torch.square(self.dof_vel), dim=1)
    
    def _reward_action_rate(self):
        # Penalize changes in actions
        return torch.sum(torch.square(self.last_actions - self.actions), dim=1)
    
    def _reward_action_smoothness(self):
        """
        Encourages smoothness in the robot's actions by penalizing large differences between consecutive actions.
        This is important for achieving fluid motion and reducing mechanical stress.
        """
        term_1 = torch.sum(torch.square(
            self.last_actions - self.actions), dim=1)
        term_2 = torch.sum(torch.square(
            self.actions + self.last_last_actions - 2 * self.last_actions), dim=1)
        term_3 = 0.05 * torch.sum(torch.abs(self.actions), dim=1)
        return term_1 + term_2 + term_3

    def _reward_ang_vel_xy(self):
        # Penalize xy axes base angular velocity
        return torch.sum(torch.square(self.base_ang_vel[:, :2]), dim=1)
    
    def _reward_orientation(self):
        # Penalize non flat base orientation
        return torch.sum(torch.square(self.projected_gravity[:, :2]), dim=1)
    
    def _reward_joint_power(self):
        # Penalize high power
        return torch.sum(torch.abs(self.dof_vel) * torch.abs(self.torques), dim=1)

    def _reward_feet_clearance(self):
        cur_footpos_translated = self.feet_pos - self.root_states[:, 0:3].unsqueeze(1)
        footpos_in_body_frame = torch.zeros(self.num_envs, len(self.feet_indices), 3, device=self.device)
        cur_footvel_translated = self.feet_vel - self.root_states[:, 7:10].unsqueeze(1)
        footvel_in_body_frame = torch.zeros(self.num_envs, len(self.feet_indices), 3, device=self.device)
        for i in range(len(self.feet_indices)):
            footpos_in_body_frame[:, i, :] = quat_rotate_inverse(self.base_quat, cur_footpos_translated[:, i, :])
            footvel_in_body_frame[:, i, :] = quat_rotate_inverse(self.base_quat, cur_footvel_translated[:, i, :])
        height_error = torch.square(footpos_in_body_frame[:, :, 2] - self.cfg.rewards.clearance_height_target).view(self.num_envs, -1)
        foot_leteral_vel = torch.sqrt(torch.sum(torch.square(footvel_in_body_frame[:, :, :2]), dim=2)).view(self.num_envs, -1)
        return torch.sum(height_error * foot_leteral_vel, dim=1)
    
    def _reward_feet_stumble(self):
        # Penalize feet hitting vertical surfaces
        rew = torch.any(torch.norm(self.contact_forces[:, self.feet_indices, :2], dim=2) >\
             3 *torch.abs(self.contact_forces[:, self.feet_indices, 2]), dim=1)
        return rew.float()
    
    def _reward_torques(self):
        # Penalize torques
        return torch.sum(torch.square(self.torques), dim=1)

    def _reward_arm_joint_deviation(self):
        return torch.square(torch.norm(torch.abs(self.dof_pos[:, 12:] - self.default_dof_pos[:, 12:]), dim=1))

    def _reward_hip_joint_deviation(self):
        return torch.square(torch.norm(torch.abs(self.dof_pos[:, [1, 2, 7, 8]]), dim=1))
    
    def _reward_dof_pos_limits(self):
        # Penalize dof positions too close to the limit
        out_of_limits = -(self.dof_pos - self.dof_pos_limits[:, 0]).clip(max=0.) # lower limit
        out_of_limits += (self.dof_pos - self.dof_pos_limits[:, 1]).clip(min=0.)
        return torch.sum(out_of_limits, dim=1)
    
    def _reward_dof_vel_limits(self):
        # Penalize dof velocities too close to the limit
        # clip to max error = 1 rad/s per joint to avoid huge penalties
        return torch.sum((torch.abs(self.dof_vel) - self.dof_vel_limits*self.cfg.rewards.soft_dof_vel_limit).clip(min=0., max=1.), dim=1)
    
    def _reward_torque_limits(self):
        # penalize torques too close to the limit
        return torch.sum((torch.abs(self.torques) - self.torque_limits*self.cfg.rewards.soft_torque_limit).clip(min=0.), dim=1)

    def _reward_no_fly(self):
        is_jump =  torch.all(self.contact_forces[:, self.feet_indices, 2] < 1, dim=1)
        return is_jump.float()
    
    def _reward_feet_lateral_distance(self):
        # Penalize feet lateral distance
        cur_footpos_translated = self.feet_pos - self.root_states[:, 0:3].unsqueeze(1)
        footpos_in_body_frame = torch.zeros(self.num_envs, len(self.feet_indices), 3, device=self.device)
        for i in range(len(self.feet_indices)):
            footpos_in_body_frame[:, i, :] = quat_rotate_inverse(self.base_quat, cur_footpos_translated[:, i, :])
        rew = (footpos_in_body_frame[:, 0, 1] - footpos_in_body_frame[:, 1, 1]) - self.cfg.rewards.feet_min_lateral_distance_target
        return torch.clip(rew, max=0.1)
    
    def _reward_feet_slippage(self):
        return torch.sum(torch.norm(self.feet_vel, dim=-1) * (torch.norm(self.contact_forces[:, self.feet_indices, :], dim=-1) > 1.), dim=1)
    
    def _reward_feet_contact_force(self):
        # penalize high contact forces
        return torch.sum(F.relu(self.contact_forces[:, self.feet_indices, 2] - self.cfg.rewards.feet_contact_force_range[0]), dim=-1)
    
    def _reward_feet_force_rate(self):
        return torch.sum(F.relu(self.contact_forces[:, self.feet_indices, 2] - self.last_feet_contact_force[..., 2]), dim=-1)
    
    def _reward_feet_contact_momentum(self):
        """
        Penalizes the momentum of the feet contact forces, encouraging a more stable and controlled motion.
        foot vel * contact force
        """
        feet_contact_force = self.contact_forces[:, self.feet_indices, 2]
        feet_vertical_vel = self.feet_vel[:, :, 2]
        rew = torch.sum(torch.abs(feet_contact_force * feet_vertical_vel), dim=-1)
        return rew
    
    def _reward_collision(self):
        # Penalize collisions on selected bodies
        return torch.sum(1.*(torch.norm(self.contact_forces[:, self.penalised_contact_indices, :], dim=-1) > 0.1), dim=1)

    def _reward_feet_air_time(self):
        # Reward long steps
        # Need to filter the contacts because the contact reporting of PhysX is unreliable on meshes
        first_contact = (self.feet_air_time > 0.) * self.contact_filt
        self.feet_air_time += self.dt
        rew_airTime = torch.sum((self.feet_air_time - 0.5) * first_contact, dim=1) # reward only on first contact with the ground
        rew_airTime *= torch.norm(self.commands[:, :2], dim=1) > 0.1 #no reward for zero command
        self.feet_air_time *= ~self.contact_filt
        return rew_airTime
    
    def _reward_stuck(self):
        # Penalize stuck
        return (torch.abs(self.base_lin_vel[:, 0]) < 0.1) * (torch.abs(self.commands[:, 0]) > 0.1)
    
    def _reward_cheat(self):
        # penalty cheating to bypass the obstacle
        no_cheat_env = torch.logical_and(self.env_class != 0, self.env_class != 1)
        forward = quat_apply(self.base_quat[no_cheat_env], self.forward_vec[no_cheat_env])
        heading = torch.atan2(forward[:, 1], forward[:, 0])
        cheat = (heading > 1.0) | (heading < -1.0)
        cheat_penalty = torch.zeros(self.num_envs, device=self.device)
        cheat_penalty[no_cheat_env] = cheat.float()
        return cheat_penalty
    
    def _reward_feet_edge(self):
        foot_indicators_pos_xy = ((self.feet_indicator_pos[..., :2]+self.terrain.cfg.border_size) / self.cfg.terrain.horizontal_scale).round().long()
        foot_indicators_pos_xy[..., 0] = torch.clip(foot_indicators_pos_xy[..., 0], 0, self.x_edge_mask.shape[0]-1)
        foot_indicators_pos_xy[..., 1] = torch.clip(foot_indicators_pos_xy[..., 1], 0, self.x_edge_mask.shape[1]-1)

        feet_at_edge = self.x_edge_mask[foot_indicators_pos_xy[..., 0], foot_indicators_pos_xy[..., 1]]
        feet_at_edge = torch.sum(feet_at_edge, dim=-1) >= 3
        feet_at_edge = self.contact_filt & feet_at_edge
        rew = (self.terrain_levels > 3) * torch.sum(feet_at_edge, dim=1)
        return torch.clip(rew, max=0.1)

    # def _reward_feet_edge(self):
    #     feet_pos_xy = ((self.rigid_body_states.view(self.num_envs, self.num_bodies, 13)[:, self.feet_indices, :2] + self.terrain.cfg.border_size) / self.cfg.terrain.horizontal_scale).round().long()  # (num_envs, 4, 2)
    #     feet_pos_xy[..., 0] = torch.clip(feet_pos_xy[..., 0], 0, self.x_edge_mask.shape[0]-1)
    #     feet_pos_xy[..., 1] = torch.clip(feet_pos_xy[..., 1], 0, self.x_edge_mask.shape[1]-1)
    #     feet_at_edge = self.x_edge_mask[feet_pos_xy[..., 0], feet_pos_xy[..., 1]]
    
    #     self.feet_at_edge = self.contact_filt & feet_at_edge
    #     rew = (self.terrain_levels > 3) * torch.sum(self.feet_at_edge, dim=-1)
    #     return rew
    
    def _reward_foot_safety(self):
        contact_moment = self.foot_touchdown if hasattr(self, "foot_touchdown") else (self.contact_filt & ~self.was_contact)
        feet_pos = self.rigid_body_states.view(self.num_envs, self.num_bodies, 13)[:, self.feet_indices, :2]
        safety = self._get_foot_safety(feet_pos.reshape(-1, 2)).reshape(self.num_envs, 2)
        return (2.0 * (safety - 0.5) * contact_moment.float()).sum(dim=-1)

    def _reward_footstep_target(self):
        rew = torch.zeros(self.num_envs, device=self.device)
        if not self._fg_enabled() or not hasattr(self, "footstep_path_active"):
            return rew
        active = self.footstep_path_active & ~self.footstep_sequence_complete & (self.footstep_target_count > 0)
        if not active.any():
            return rew
        env_ids = torch.nonzero(active, as_tuple=False).flatten()
        idx = self.footstep_pair_idx[env_ids].clamp(max=self.footstep_max_targets - 1)
        valid = self.footstep_targets_valid[env_ids, idx]
        env_ids = env_ids[valid]
        idx = idx[valid]
        if env_ids.numel() == 0:
            return rew
        targets = self.footstep_targets_xy[env_ids, idx]
        feet_xy = self.feet_pos[env_ids, :, :2]
        dist = torch.norm(feet_xy - targets, dim=-1)
        sigma = float(getattr(self._fg_cfg(), "target_sigma", 0.12))
        hit_radius = float(getattr(self._fg_cfg(), "target_hit_radius", 0.18))
        needed = torch.stack([~self.footstep_left_done[env_ids], ~self.footstep_right_done[env_ids]], dim=1)
        hit = self.foot_touchdown[env_ids] & needed & (dist < hit_radius)
        reward = torch.exp(-(dist / sigma) ** 2) * hit.float()
        rew[env_ids] = reward.sum(dim=1)
        if hit.any():
            self.footstep_left_done[env_ids] |= hit[:, 0]
            self.footstep_right_done[env_ids] |= hit[:, 1]
            self.footstep_hit_count[env_ids] += hit.float().sum(dim=1)
        pair_done = self.footstep_left_done[env_ids] & self.footstep_right_done[env_ids]
        done_envs = env_ids[pair_done]
        if done_envs.numel() > 0:
            next_idx = self.footstep_pair_idx[done_envs] + 1
            has_next = next_idx < self.footstep_target_count[done_envs]
            advance_envs = done_envs[has_next]
            complete_envs = done_envs[~has_next]
            if advance_envs.numel() > 0:
                self.footstep_pair_idx[advance_envs] += 1
                self.footstep_left_done[advance_envs] = False
                self.footstep_right_done[advance_envs] = False
            if complete_envs.numel() > 0:
                self.footstep_sequence_complete[complete_envs] = True
        return rew

    def _reward_footstep_skip(self):
        if not hasattr(self, "footstep_skip_events"):
            return torch.zeros(self.num_envs, device=self.device)
        return self.footstep_skip_events.float().sum(dim=1)

    def _reward_y_offset_pen(self):
        pen = torch.abs(self.root_states[:, 1] - self.origin_y) * torch.logical_and(self.env_class != 0, self.env_class != 1)
        return pen
